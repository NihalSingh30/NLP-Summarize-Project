mmary)\n        st.caption(f\"Waktu inferensi: {elapsed:.2f} detik\")\n'''\n\nwith open('app.py', 'w') as f:\n    f.write(streamlit_app)\n\nprint('app.py saved. Jalankan: streamlit run app.py')"
   ]
  }
 ]
}"
